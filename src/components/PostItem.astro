---
import type { CollectionEntry } from 'astro:content';
import { CATEGORY_LABELS, CATEGORY_COLORS } from '../consts';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, category, pubDate } = post.data;
---

<article data-category={category}>
  <a
    href={`/blog/${post.id}`}
    class="group -mx-5 block rounded-2xl px-5 py-5 transition-colors hover:bg-paper-2"
  >
    <p class="flex items-center gap-2 text-xs font-semibold text-ink-muted">
      <span class="h-2.5 w-2.5 rounded-full ring-2 ring-ink/15" style={`background:${CATEGORY_COLORS[category]}`} />
      {CATEGORY_LABELS[category]}
      <span class="text-ink-faint">·</span>
      <time class="font-normal text-ink-faint" datetime={pubDate.toISOString()}>
        {pubDate.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>
    </p>
    <h3 class="mt-2.5 font-display text-xl leading-snug text-ink transition-colors group-hover:text-plum">
      {title}
      <span class="inline-block text-plum opacity-0 transition-all group-hover:translate-x-1 group-hover:opacity-100" aria-hidden="true">→</span>
    </h3>
    <p class="mt-2 line-clamp-2 leading-relaxed text-ink-muted">{description}</p>
  </a>
</article>
