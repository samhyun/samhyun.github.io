---
import { NAV_ITEMS } from '../consts';
import ThemeToggle from './ThemeToggle.astro';

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b-2 border-ink/10 bg-paper/90 backdrop-blur">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-5 py-3.5">
    <a href="/" class="group flex items-center gap-2.5">
      <span class="logo-key flex h-9 w-9 items-center justify-center rounded-lg border-2 border-edge bg-butter font-display text-base text-on-pastel shadow-[3px_3px_0_var(--edge-shadow)] transition-transform group-hover:animate-[wiggle_0.4s_ease-in-out]">
        S
      </span>
      <span class="hidden font-display text-lg text-ink sm:inline">samhyun</span>
    </a>

    <div class="flex items-center gap-0.5 sm:gap-1">
      {NAV_ITEMS.map((item) => (
        <a
          href={item.href}
          aria-current={currentPath.startsWith(item.href) ? 'page' : undefined}
          class:list={[
            'rounded-full px-3 py-1.5 text-sm font-semibold transition-colors sm:px-3.5',
            currentPath.startsWith(item.href)
              ? 'bg-butter text-on-pastel'
              : 'text-ink-muted hover:bg-paper-2 hover:text-ink',
          ]}
        >
          {item.label}
        </a>
      ))}
      <ThemeToggle />
    </div>
  </nav>
</header>
