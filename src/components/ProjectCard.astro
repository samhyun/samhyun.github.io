---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
  compact?: boolean;
}

const { project, index, compact = false } = Astro.props;
const { title, role, period, description, techStack, highlights, type } = project.data;

const bandColors = ['var(--butter)', 'var(--mint)', 'var(--lilac)', 'var(--peach)'];
const band = bandColors[index % bandColors.length];
---

<a href={`/projects/${project.id}`} class="sticker-card group overflow-hidden">
  <div class="flex items-center justify-between border-b-2 border-edge px-5 py-2.5 md:px-6" style={`background:${band}`}>
    <span class="font-display text-sm text-on-pastel">
      {type === 'personal' ? 'Side Project' : String(index + 1).padStart(2, '0')}
    </span>
    <span class="text-xs font-semibold text-on-pastel/75">{period}</span>
  </div>

  <div class:list={['px-5 md:px-6', compact ? 'py-5' : 'py-6 md:py-7']}>
    <h3 class:list={['font-display leading-snug text-ink transition-colors group-hover:text-plum', compact ? 'text-lg' : 'text-2xl']}>
      {title}
    </h3>
    <p class="mt-1.5 text-sm font-semibold text-plum">{role}</p>
    <p class:list={['mt-3 leading-relaxed text-ink-muted', compact && 'text-sm']}>{description}</p>

    {!compact && (
      <>
        <ul class="mt-5 flex flex-wrap gap-1.5">
          {techStack.map((tech) => (
            <li class="rounded-full bg-paper-2 px-2.5 py-0.5 text-xs font-semibold text-ink-muted">{tech}</li>
          ))}
        </ul>

        {highlights.length > 0 && (
          <ul class="mt-5 space-y-2 border-t-2 border-dashed border-rule pt-5">
            {highlights.slice(0, 3).map((h) => (
              <li class="flex items-start gap-2.5 text-sm leading-relaxed text-ink-muted">
                <span class="mt-0.5 flex h-4.5 w-4.5 shrink-0 items-center justify-center rounded-full border-2 border-edge bg-mint">
                  <svg class="h-2.5 w-2.5 text-on-pastel" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="4"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </span>
                {h}
              </li>
            ))}
          </ul>
        )}

        <p class="mt-6 text-sm font-bold text-ink">
          자세히 보기
          <span class="inline-block text-plum transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
        </p>
      </>
    )}
  </div>
</a>
