---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allProjects = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order);

const workProjects = allProjects.filter(p => p.data.type !== 'personal');
const personalProjects = allProjects.filter(p => p.data.type === 'personal');
---

<BaseLayout title="Projects" description="실무에서 진행한 프로젝트와 기술적 성과를 소개합니다.">
  <div class="py-4">
    <h1 class="mb-2 text-3xl font-extrabold">Projects</h1>
    <p class="mb-10 text-text-muted dark:text-text-muted-dark">
      실무에서 설계하고 구축한 시스템과 사이드 프로젝트를 소개합니다.
    </p>

    <!-- Work Projects -->
    <section>
      <h2 class="mb-6 text-lg font-bold text-text-muted dark:text-text-muted-dark">Work</h2>
      <div class="stagger-children space-y-8">
        {workProjects.map((project, i) => (
          <a href={`/projects/${project.id}`} class="gradient-border card-hover group block overflow-hidden rounded-xl border border-border p-6 md:p-8 dark:border-border-dark">
            <div class="mb-4 flex items-center gap-3">
              <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary-100 text-sm font-bold text-primary-700 dark:bg-primary-900/30 dark:text-primary-400">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="text-xs font-medium text-text-muted dark:text-text-muted-dark">
                {project.data.period}
              </span>
            </div>

            <h3 class="text-2xl font-bold group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
              {project.data.title}
            </h3>
            <p class="mt-1 text-sm font-medium text-accent-500 dark:text-accent-400">
              {project.data.role}
            </p>
            <p class="mt-3 leading-relaxed text-text-muted dark:text-text-muted-dark">
              {project.data.description}
            </p>

            <div class="mt-5 flex flex-wrap gap-1.5">
              {project.data.techStack.map((tech) => (
                <span class="rounded-md border border-border bg-surface px-2 py-0.5 text-xs font-medium text-text-muted dark:border-border-dark dark:bg-surface-dark dark:text-text-muted-dark">
                  {tech}
                </span>
              ))}
            </div>

            {project.data.highlights.length > 0 && (
              <ul class="mt-5 space-y-2 border-t border-border pt-5 dark:border-border-dark">
                {project.data.highlights.slice(0, 3).map((h) => (
                  <li class="flex items-start gap-2.5 text-sm text-text-muted dark:text-text-muted-dark">
                    <svg class="mt-0.5 h-4 w-4 shrink-0 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                    {h}
                  </li>
                ))}
              </ul>
            )}

            <div class="mt-5 flex items-center gap-1 text-sm font-medium text-primary-600 dark:text-primary-400 opacity-0 transition-opacity group-hover:opacity-100">
              자세히 보기
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Side Projects -->
    {personalProjects.length > 0 && (
      <section class="mt-16">
        <h2 class="mb-6 text-lg font-bold text-text-muted dark:text-text-muted-dark">Side Projects</h2>
        <div class="stagger-children space-y-8">
          {personalProjects.map((project) => (
            <a href={`/projects/${project.id}`} class="gradient-border card-hover group block overflow-hidden rounded-xl border border-border p-6 md:p-8 dark:border-border-dark">
              <div class="mb-4 flex items-center gap-3">
                <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-violet-100 text-sm font-bold text-violet-700 dark:bg-violet-900/30 dark:text-violet-400">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                </span>
                <span class="text-xs font-medium text-text-muted dark:text-text-muted-dark">
                  {project.data.period}
                </span>
              </div>

              <h3 class="text-2xl font-bold group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                {project.data.title}
              </h3>
              <p class="mt-1 text-sm font-medium text-accent-500 dark:text-accent-400">
                {project.data.role}
              </p>
              <p class="mt-3 leading-relaxed text-text-muted dark:text-text-muted-dark">
                {project.data.description}
              </p>

              <div class="mt-5 flex flex-wrap gap-1.5">
                {project.data.techStack.map((tech) => (
                  <span class="rounded-md border border-border bg-surface px-2 py-0.5 text-xs font-medium text-text-muted dark:border-border-dark dark:bg-surface-dark dark:text-text-muted-dark">
                    {tech}
                  </span>
                ))}
              </div>

              {project.data.highlights.length > 0 && (
                <ul class="mt-5 space-y-2 border-t border-border pt-5 dark:border-border-dark">
                  {project.data.highlights.slice(0, 3).map((h) => (
                    <li class="flex items-start gap-2.5 text-sm text-text-muted dark:text-text-muted-dark">
                      <svg class="mt-0.5 h-4 w-4 shrink-0 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                      {h}
                    </li>
                  ))}
                </ul>
              )}

              <div class="mt-5 flex items-center gap-1 text-sm font-medium text-primary-600 dark:text-primary-400 opacity-0 transition-opacity group-hover:opacity-100">
                자세히 보기
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    {allProjects.length === 0 && (
      <p class="text-text-muted dark:text-text-muted-dark">프로젝트가 준비 중입니다.</p>
    )}
  </div>
</BaseLayout>
