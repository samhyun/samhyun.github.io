---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBanner from '../../components/PageBanner.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ProjectsArt from '../../components/ProjectsArt.astro';
import { getCollection } from 'astro:content';

const allProjects = (await getCollection('projects', ({ data }) => import.meta.env.PROD ? !data.draft : true))
  .sort((a, b) => a.data.order - b.data.order);

const workProjects = allProjects.filter(p => p.data.type !== 'personal');
const featuredWorkProjects = workProjects.filter(p => p.data.featured);
const otherWorkProjects = workProjects.filter(p => !p.data.featured);
const personalProjects = allProjects.filter(p => p.data.type === 'personal');

const description = '실무에서 설계하고 구축한 시스템과 사이드 프로젝트를 소개합니다.';
---

<BaseLayout title="Projects" description={description}>
  <PageBanner slot="banner" title="Projects" description={description}>
    <ul class="mt-6 flex flex-wrap gap-2">
      <li class="rounded-full border-2 border-edge bg-paper px-3 py-1 text-sm font-semibold text-ink-muted">
        실무 <span class="font-display text-ink">{workProjects.length}</span>개
      </li>
      <li class="rounded-full border-2 border-edge bg-paper px-3 py-1 text-sm font-semibold text-ink-muted">
        사이드 <span class="font-display text-ink">{personalProjects.length}</span>개
      </li>
    </ul>
    <ProjectsArt slot="art" />
  </PageBanner>

  <!-- Featured Work Projects -->
  <section>
    <h2 class="mb-6 font-display text-2xl text-ink">주요 실무 프로젝트</h2>
    <div class="space-y-8">
      {featuredWorkProjects.map((project, i) => (
        <ProjectCard project={project} index={i} />
      ))}
    </div>
  </section>

  <!-- Other Work Projects -->
  {otherWorkProjects.length > 0 && (
    <section class="mt-16">
      <h2 class="mb-6 font-display text-2xl text-ink">그 밖의 실무 프로젝트</h2>
      <div class="grid gap-6 md:grid-cols-2">
        {otherWorkProjects.map((project, i) => (
          <ProjectCard project={project} index={featuredWorkProjects.length + i} compact />
        ))}
      </div>
    </section>
  )}

  <!-- Side Projects -->
  {personalProjects.length > 0 && (
    <section class="mt-16">
      <h2 class="mb-6 font-display text-2xl text-ink">Side Projects</h2>
      <div class="space-y-8">
        {personalProjects.map((project, i) => (
          <ProjectCard project={project} index={i + 2} />
        ))}
      </div>
    </section>
  )}

  {allProjects.length === 0 && (
    <p class="text-ink-muted">프로젝트가 준비 중입니다.</p>
  )}
</BaseLayout>
