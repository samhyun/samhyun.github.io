---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categories = ['all', 'spring', 'aws', 'ai', 'testing', 'devops', 'etc'] as const;
const categoryLabels: Record<string, string> = {
  all: '전체',
  spring: 'Spring',
  aws: 'AWS & Infra',
  ai: 'AI & Chatbot',
  testing: 'Testing',
  devops: 'DevOps',
  etc: '기타',
};

const categoryColors: Record<string, string> = {
  spring: 'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400',
  aws: 'bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400',
  ai: 'bg-violet-100 text-violet-700 dark:bg-violet-900/30 dark:text-violet-400',
  testing: 'bg-cyan-100 text-cyan-700 dark:bg-cyan-900/30 dark:text-cyan-400',
  devops: 'bg-rose-100 text-rose-700 dark:bg-rose-900/30 dark:text-rose-400',
  etc: 'bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-400',
};
---

<BaseLayout title="Blog" description="실무에서 겪은 문제 해결 과정과 기술적 의사결정을 기록합니다.">
  <div class="py-4">
    <h1 class="mb-2 text-3xl font-extrabold">Blog</h1>
    <p class="mb-8 text-text-muted dark:text-text-muted-dark">
      실무에서 겪은 문제 해결 과정과 기술적 의사결정을 기록합니다.
    </p>

    <!-- Category Filter -->
    <div class="mb-8 flex flex-wrap gap-2" id="category-filter">
      {categories.map((cat) => (
        <button
          data-category={cat}
          class:list={[
            'rounded-lg px-3.5 py-1.5 text-sm font-medium transition-all',
            cat === 'all'
              ? 'bg-primary-600 text-white shadow-sm shadow-primary-500/25 dark:bg-primary-500'
              : 'bg-gray-100 text-text-muted hover:bg-gray-200 dark:bg-gray-800 dark:text-text-muted-dark dark:hover:bg-gray-700',
          ]}
        >
          {categoryLabels[cat]}
        </button>
      ))}
    </div>

    <!-- Posts List -->
    <div class="stagger-children space-y-4" id="posts-list">
      {posts.map((post) => (
        <article data-category={post.data.category}>
          <a href={`/blog/${post.id}`} class="group block rounded-xl border border-border bg-surface p-5 transition-all hover:border-primary-200 hover:shadow-md hover:-translate-y-0.5 dark:border-border-dark dark:bg-surface-alt-dark dark:hover:border-primary-800">
            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0">
                <div class="mb-2 flex items-center gap-2">
                  <span class:list={['rounded-md px-2 py-0.5 text-[11px] font-bold uppercase tracking-wide', categoryColors[post.data.category]]}>
                    {categoryLabels[post.data.category]}
                  </span>
                  <time class="text-xs text-text-muted dark:text-text-muted-dark" datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toLocaleDateString('ko-KR', { year: 'numeric', month: 'short', day: 'numeric' })}
                  </time>
                </div>
                <h2 class="text-lg font-bold group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                  {post.data.title}
                </h2>
                <p class="mt-1.5 text-sm leading-relaxed text-text-muted dark:text-text-muted-dark line-clamp-2">
                  {post.data.description}
                </p>
                <div class="mt-3 flex flex-wrap items-center gap-2">
                  {post.data.tags.slice(0, 4).map((tag) => (
                    <span class="rounded-md bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-400">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
              <svg class="mt-3 h-5 w-5 shrink-0 text-text-muted/30 transition-all group-hover:text-primary-500 group-hover:translate-x-1 dark:text-text-muted-dark/30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
            </div>
          </a>
        </article>
      ))}
    </div>

    {posts.length === 0 && (
      <p class="text-text-muted dark:text-text-muted-dark">아직 작성된 글이 없습니다.</p>
    )}
  </div>
</BaseLayout>

<script>
  function setupFilter() {
    const buttons = document.querySelectorAll('#category-filter button');
    const posts = document.querySelectorAll('#posts-list article');

    const activeClass = ['bg-primary-600', 'text-white', 'shadow-sm', 'shadow-primary-500/25', 'dark:bg-primary-500'];
    const inactiveClass = ['bg-gray-100', 'text-text-muted', 'hover:bg-gray-200', 'dark:bg-gray-800', 'dark:text-text-muted-dark', 'dark:hover:bg-gray-700'];

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const category = (btn as HTMLElement).dataset.category;

        buttons.forEach((b) => {
          activeClass.forEach(c => b.classList.remove(c));
          inactiveClass.forEach(c => b.classList.add(c));
        });
        inactiveClass.forEach(c => btn.classList.remove(c));
        activeClass.forEach(c => btn.classList.add(c));

        posts.forEach((post) => {
          const el = post as HTMLElement;
          if (category === 'all' || el.dataset.category === category) {
            el.style.display = '';
          } else {
            el.style.display = 'none';
          }
        });
      });
    });
  }

  setupFilter();
  document.addEventListener('astro:after-swap', setupFilter);
</script>
