---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBanner from '../../components/PageBanner.astro';
import PostItem from '../../components/PostItem.astro';
import BlogArt from '../../components/BlogArt.astro';
import { getCollection } from 'astro:content';
import { CATEGORY_LABELS, CATEGORY_COLORS } from '../../consts';

const posts = (await getCollection('blog', ({ data }) => import.meta.env.PROD ? !data.draft : true))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categories = ['all', 'spring', 'aws', 'ai', 'workflow', 'testing', 'devops', 'analysis', 'etc'] as const;
const categoryLabels: Record<string, string> = { all: '전체', ...CATEGORY_LABELS };

const years = [...new Set(posts.map((post) => post.data.pubDate.getFullYear()))];
const usedCategoryCount = new Set(posts.map((post) => post.data.category)).size;
const description = '실무에서 겪은 문제 해결 과정과 기술적 의사결정을 기록합니다.';
---

<BaseLayout title="Blog" description={description}>
  <PageBanner slot="banner" title="Blog" description={description}>
    <ul class="mt-6 flex flex-wrap gap-2">
      <li class="rounded-full border-2 border-edge bg-paper px-3 py-1 text-sm font-semibold text-ink-muted">
        글 <span class="font-display text-ink">{posts.length}</span>편
      </li>
      <li class="rounded-full border-2 border-edge bg-paper px-3 py-1 text-sm font-semibold text-ink-muted">
        카테고리 <span class="font-display text-ink">{usedCategoryCount}</span>개
      </li>
    </ul>
    <BlogArt slot="art" />
  </PageBanner>

  <!-- Category Filter -->
  <div class="no-scrollbar -mx-5 flex gap-2 overflow-x-auto px-5 pt-1 pb-2 sm:mx-0 sm:flex-wrap sm:overflow-visible sm:px-0" id="category-filter">
    {categories.map((cat) => (
      <button
        type="button"
        data-category={cat}
        aria-pressed={cat === 'all' ? 'true' : 'false'}
        class="filter-chip inline-flex shrink-0 cursor-pointer items-center whitespace-nowrap gap-2 rounded-full border-2 border-rule px-3.5 py-1.5 text-sm font-semibold text-ink-muted transition-all hover:border-edge hover:text-ink"
      >
        {cat !== 'all' && (
          <span class="h-2.5 w-2.5 rounded-full" style={`background:${CATEGORY_COLORS[cat]}`} />
        )}
        {categoryLabels[cat]}
      </button>
    ))}
  </div>

  <!-- Posts List -->
  <div id="posts-list">
    {years.map((year) => (
      <section data-year-group class="mt-12">
        <h2 class="mb-2 font-display text-2xl text-ink-faint">{year}</h2>
        <div class="divide-y-2 divide-dashed divide-rule">
          {posts
            .filter((post) => post.data.pubDate.getFullYear() === year)
            .map((post) => <PostItem post={post} />)}
        </div>
      </section>
    ))}
  </div>

  {posts.length === 0 && (
    <p class="mt-10 text-ink-muted">아직 작성된 글이 없습니다.</p>
  )}
</BaseLayout>

<script>
  function setupFilter() {
    const buttons = document.querySelectorAll<HTMLElement>('#category-filter button');
    const posts = document.querySelectorAll<HTMLElement>('#posts-list article');
    const groups = document.querySelectorAll<HTMLElement>('#posts-list [data-year-group]');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const category = btn.dataset.category;

        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));

        posts.forEach((post) => {
          const visible = category === 'all' || post.dataset.category === category;
          post.style.display = visible ? '' : 'none';
        });

        groups.forEach((group) => {
          const hasVisible = [...group.querySelectorAll<HTMLElement>('article')].some((a) => a.style.display !== 'none');
          group.style.display = hasVisible ? '' : 'none';
        });
      });
    });
  }

  setupFilter();
  document.addEventListener('astro:after-swap', setupFilter);
</script>
