---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { CATEGORY_LABELS, CATEGORY_COLORS } from '../../consts';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => import.meta.env.PROD ? !data.draft : true);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

const post = Astro.props;
const { Content, headings } = await render(post);

const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
// 목차가 없는 글은 본문을 가운데 한 열로 둔다
const hasToc = tocHeadings.length > 0;
---

<BaseLayout title={post.data.title} description={post.data.description} ogImage={`/og/${post.id}.png`} wide>
  <header slot="banner" class="relative overflow-hidden bg-paper-2">
    <svg class="pointer-events-none absolute top-8 right-[8%] hidden h-40 w-40 md:block" viewBox="0 0 160 160" aria-hidden="true">
      <circle cx="96" cy="64" r="46" fill="var(--butter)" />
      <circle cx="40" cy="120" r="16" fill="var(--lilac)" stroke="var(--edge)" stroke-width="3" />
      <path d="M140 118 l4 10 l10 4 l-10 4 l-4 10 l-4 -10 l-10 -4 l10 -4 z" fill="var(--plum)" />
    </svg>
    <div class:list={['relative mx-auto px-5 pt-10 pb-14 md:pt-20 md:pb-24', hasToc ? 'max-w-6xl' : 'max-w-[46.5rem]']}>
      <p class="flex items-center gap-2 text-sm font-semibold text-ink-muted">
        <span class="h-3 w-3 rounded-full ring-2 ring-ink/15" style={`background:${CATEGORY_COLORS[post.data.category]}`} />
        {CATEGORY_LABELS[post.data.category]}
      </p>
      <h1 class="mt-4 max-w-3xl font-display text-3xl leading-[1.3] text-ink md:text-[2.75rem]" style="word-break: keep-all">
        {post.data.title}
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-muted" style="word-break: keep-all">{post.data.description}</p>
      <p class="mt-6 text-sm text-ink-faint">
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        {post.data.updatedDate && (
          <span> · 수정 {post.data.updatedDate.toLocaleDateString('ko-KR')}</span>
        )}
      </p>
    </div>
    <svg class="absolute inset-x-0 -bottom-px h-8 w-full text-paper md:h-12" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
      <path fill="currentColor" d="M0 40 C 320 80, 640 0, 960 36 S 1300 70, 1440 30 L1440 80 L0 80 Z" />
    </svg>
  </header>

  <div class:list={['grid gap-12', hasToc ? 'lg:grid-cols-[minmax(0,44rem)_15rem] lg:justify-between' : 'mx-auto max-w-[44rem]']}>
    <article class="w-full min-w-0">
      <!-- 좁은 화면 목차 -->
      {tocHeadings.length > 0 && (
        <details class="mb-10 rounded-2xl bg-paper-2 px-5 py-4 lg:hidden">
          <summary class="eyebrow cursor-pointer text-ink-muted">Table of Contents</summary>
          <ul class="mt-3 space-y-2">
            {tocHeadings.map((h) => (
              <li style={`padding-left: ${(h.depth - 2) * 0.875}rem`}>
                <a href={`#${h.slug}`} class="text-sm text-ink-muted hover:text-plum">{h.text}</a>
              </li>
            ))}
          </ul>
        </details>
      )}

      <div class="prose">
        <Content />
      </div>

      {post.data.tags.length > 0 && (
        <ul class="mt-14 flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <li class="rounded-full bg-paper-2 px-3 py-1 text-sm text-ink-muted">#{tag}</li>
          ))}
        </ul>
      )}

      <div class="mt-10 border-t-2 border-dashed border-rule pt-8">
        <a href="/blog" class="sticker-btn bg-paper">&larr; 블로그 목록으로</a>
      </div>
    </article>

    <!-- 따라다니는 목차 -->
    {tocHeadings.length > 0 && (
      <aside class="hidden lg:block">
        <nav class="sticky top-24 max-h-[calc(100vh-8rem)] overflow-x-hidden overflow-y-auto pr-2 pb-8" aria-label="목차">
          <h2 class="eyebrow mb-4 text-ink-faint">Table of Contents</h2>
          <ul class="space-y-2.5" id="toc">
            {tocHeadings.map((h) => (
              <li style={`padding-left: ${(h.depth - 2) * 0.875}rem`}>
                <a
                  href={`#${h.slug}`}
                  data-slug={h.slug}
                  class="toc-link block text-sm leading-snug text-ink-faint transition-colors hover:text-ink"
                >
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>
    )}
  </div>
</BaseLayout>

<script>
  // Mermaid 초기화
  async function initMermaid() {
    const mermaidBlocks = document.querySelectorAll('.prose pre[data-language="mermaid"]');
    if (mermaidBlocks.length === 0) return;

    const { default: mermaid } = await import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs');
    const isDark = document.documentElement.classList.contains('dark');
    mermaid.initialize({
      startOnLoad: false,
      theme: isDark ? 'dark' : 'neutral',
      fontFamily: 'ui-sans-serif, system-ui, -apple-system, sans-serif',
    });

    for (const pre of mermaidBlocks) {
      const code = pre.querySelector('code');
      const container = document.createElement('div');
      container.className = 'mermaid';
      container.textContent = code?.textContent ?? '';
      pre.replaceWith(container);
    }

    await mermaid.run({ nodes: document.querySelectorAll('.mermaid') });
  }
  initMermaid();

  // 목차: 지금 읽는 섹션 표시
  const tocLinks = document.querySelectorAll<HTMLAnchorElement>('#toc .toc-link');
  if (tocLinks.length > 0) {
    const targets = [...tocLinks]
      .map((link) => document.getElementById(link.dataset.slug ?? ''))
      .filter((el): el is HTMLElement => el !== null);

    const setActive = () => {
      let current = targets[0]?.id;
      for (const el of targets) {
        if (el.getBoundingClientRect().top < 140) current = el.id;
      }
      tocLinks.forEach((link) => link.classList.toggle('is-active', link.dataset.slug === current));
    };
    setActive();
    window.addEventListener('scroll', setActive, { passive: true });
  }

  // 코드 블록 복사 버튼
  const copyIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>`;
  const checkIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`;

  document.querySelectorAll('.prose pre').forEach((pre) => {
    if (pre.getAttribute('data-language') === 'mermaid') return;
    const lang = pre.getAttribute('data-language') || '';

    const wrapper = document.createElement('div');
    wrapper.className = 'code-block-wrapper';
    pre.parentNode!.insertBefore(wrapper, pre);

    // Header bar
    const header = document.createElement('div');
    header.className = 'code-block-header';

    const langLabel = document.createElement('span');
    if (lang) {
      langLabel.className = 'code-block-lang';
      langLabel.textContent = lang;
    }

    const btn = document.createElement('button');
    btn.className = 'copy-btn';
    btn.setAttribute('aria-label', '코드 복사');
    btn.innerHTML = `${copyIcon}<span class="copy-label">Copy</span>`;

    header.appendChild(langLabel);
    header.appendChild(btn);
    wrapper.appendChild(header);
    wrapper.appendChild(pre);

    btn.addEventListener('click', async () => {
      const code = pre.querySelector('code')?.textContent ?? pre.textContent ?? '';
      await navigator.clipboard.writeText(code);
      btn.innerHTML = `${checkIcon}<span class="copy-label">Copied!</span>`;
      btn.classList.add('copied');
      setTimeout(() => {
        btn.innerHTML = `${copyIcon}<span class="copy-label">Copy</span>`;
        btn.classList.remove('copied');
      }, 2000);
    });
  });
</script>
