---
import BaseLayout from '../layouts/BaseLayout.astro';
import Scene from '../components/Scene.astro';
import PostItem from '../components/PostItem.astro';
import { getCollection } from 'astro:content';
import { SITE_AUTHOR } from '../consts';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

const chipColors = ['var(--mint)', 'var(--butter)', 'var(--lilac)', 'var(--peach)'];
const techStack = [
  'Spring Boot', 'Kotlin', 'Java', 'Python', 'Google ADK', 'AWS', 'GCP',
  'Docker', 'Terraform', 'PostgreSQL', 'Redis', 'LangChain', 'RAG',
];
---

<BaseLayout wide>
  <section slot="banner" class="relative overflow-hidden bg-paper-2">
    <div class="mx-auto grid max-w-6xl items-center gap-4 px-5 pt-10 pb-14 md:grid-cols-[1.1fr_1fr] md:gap-6 md:pt-20 md:pb-28">
      <div>
        <p class="eyebrow text-plum">Software Engineer</p>
        <h1 class="mt-4 font-display text-[2.75rem] leading-[1.1] text-ink md:text-6xl">
          {SITE_AUTHOR}
        </h1>
        <p class="mt-6 max-w-md text-lg leading-relaxed text-ink-muted" style="word-break: keep-all">
          궁금한 기술이 생기면 직접 써보고 만들어봅니다.
          Spring 백엔드와 클라우드 인프라, AI 에이전트 프로젝트에서 겪은 고민과 시행착오를 기록합니다.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/projects" class="sticker-btn bg-butter">프로젝트 보기</a>
          <a href="/blog" class="sticker-btn bg-paper">블로그 읽기</a>
        </div>
      </div>
      <Scene class="mx-auto w-full max-w-[340px] md:max-w-[560px]" />
    </div>
    <svg class="absolute inset-x-0 -bottom-px h-10 w-full text-paper md:h-14" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
      <path fill="currentColor" d="M0 48 C 240 8, 480 8, 720 40 S 1200 80, 1440 32 L1440 80 L0 80 Z" />
    </svg>
  </section>

  <div class="grid gap-14 pt-2 lg:grid-cols-[minmax(0,1fr)_18rem] lg:gap-20">
    <!-- Recent Posts -->
    <section>
      <div class="mb-2 flex items-end justify-between">
        <h2 class="font-display text-2xl text-ink">Latest Posts</h2>
        <a href="/blog" class="link-hl text-sm">모두 보기</a>
      </div>
      <div class="divide-y-2 divide-dashed divide-rule">
        {posts.map((post) => <PostItem post={post} />)}
      </div>
      {posts.length === 0 && (
        <p class="text-ink-muted">아직 작성된 글이 없습니다.</p>
      )}
    </section>

    <!-- Tech Stack -->
    <aside class="lg:pt-3">
      <h2 class="eyebrow mb-4 text-plum">Tech Stack</h2>
      <ul class="flex flex-wrap gap-2">
        {techStack.map((tech, i) => (
          <li
            class="rounded-full border-2 border-edge/80 px-3 py-1 text-sm font-semibold text-on-pastel transition-transform hover:-translate-y-0.5 hover:-rotate-2"
            style={`background:${chipColors[i % chipColors.length]}`}
          >
            {tech}
          </li>
        ))}
      </ul>
    </aside>
  </div>
</BaseLayout>
