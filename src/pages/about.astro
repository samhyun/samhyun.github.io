---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import { SITE_AUTHOR, SOCIAL_LINKS } from '../consts';

const experiences = [
  {
    period: '2025.09 — 2026.03',
    company: 'LG전자 HVAC AI 챗봇 프로젝트 (프리랜서)',
    role: '백엔드 / AI Agent 개발자',
    description: 'LG전자 HVAC AI 챗봇의 백엔드와 멀티 에이전트 구조를 설계하고 개발했다. WebFlux 기반 스트리밍 API와 실시간 STT, Terraform 기반 멀티 클라우드 배포 환경을 구축했다.',
    techs: ['Java 21', 'Python', 'Spring Boot 3.5', 'Google ADK', 'LangChain4j', 'FastAPI', 'React 19', 'MySQL', 'Milvus', 'AWS', 'GCP', 'Azure', 'Terraform'],
  },
  {
    period: '2021.05 — 2024.11',
    company: '(주)일루미나리안',
    role: '백엔드 TechLead',
    description: 'MusicSharesJP와 GoodVibeWorks의 백엔드 아키텍처를 설계하고 핵심 API를 개발했다. 공용 API 문서 서버와 Kotlin Test DSL, Spring Cloud Config 기반 설정 관리 체계도 구축했다.',
    techs: ['Kotlin', 'Java', 'Spring Boot', 'Spring Cloud', 'JPA', 'Querydsl', 'MySQL', 'AWS', 'Docker', 'Jenkins'],
  },
  {
    period: '2020.12 — 2021.04',
    company: 'LOTTE GFR (프리랜서)',
    role: '풀스택 개발자',
    description: 'NICE CLAUP e커머스 플랫폼의 회원·상품 관리 API와 프론트엔드를 개발했다. Facebook Graph API로 인스타그램 브랜드 피드를 연계했다.',
    techs: ['Java', 'TypeScript', 'Spring Boot', 'Vue.js', 'JPA', 'MySQL', 'Redis'],
  },
  {
    period: '2015.09 — 2020.05',
    company: '(주)애니포인트미디어',
    role: '풀스택 개발자',
    description: 'TV 광고 플랫폼 1.0과 2.0을 설계·구축하고 SKB 통합 광고 시스템의 아키텍처를 설계했다. Axon Framework 기반 CQRS와 AWS 인프라를 적용하고 운영했다.',
    techs: ['Kotlin', 'Java', 'TypeScript', 'Spring Boot', 'Spring Cloud', 'Vue.js', 'AngularJS', 'Axon Framework', 'MySQL', 'Redis', 'AWS'],
  },
  {
    period: '2013.02 — 2015.06',
    company: '(주)뚝딱',
    role: '풀스택 / 백엔드 개발자',
    description: '한국전력공사 전력연구원 수요 예측 시스템의 R 통계 모델과 서비스 API를 개발했다. 특허청 특허출원 프로그램과 자체 해운 솔루션 개발에도 참여했다.',
    techs: ['Java', 'JavaScript', 'R', 'Spring Framework', 'jQuery', 'MyBatis', 'Oracle'],
  },
];

const skills = [
  {
    category: 'Backend',
    icon: '{ }',
    items: ['Java', 'Kotlin', 'Spring Boot', 'Spring WebFlux', 'Spring Cloud', 'JPA', 'Querydsl', 'FastAPI'],
    color: 'var(--lilac)',
  },
  {
    category: 'AI Agent',
    icon: 'AI',
    items: ['Google ADK', 'LangGraph', 'LangChain4j', 'LangChain', 'RAG', 'LangSmith', 'OpenAI API'],
    color: 'var(--butter)',
  },
  {
    category: 'Cloud & Infra',
    icon: 'C',
    items: ['AWS', 'GCP', 'Azure', 'Docker', 'Terraform'],
    color: 'var(--peach)',
  },
  {
    category: 'Frontend',
    icon: 'F',
    items: ['JavaScript', 'TypeScript', 'React', 'Next.js', 'Vue.js', 'SwiftUI'],
    color: 'var(--mint)',
  },
  {
    category: 'Database',
    icon: 'DB',
    items: ['MySQL', 'PostgreSQL', 'pgvector', 'Redis', 'Oracle', 'Milvus'],
    color: 'var(--lilac)',
  },
  {
    category: 'DevOps',
    icon: 'D',
    items: ['Jenkins', 'GitHub Actions', 'Git', 'SonarQube'],
    color: 'var(--butter)',
  },
];

const certifications = [
  { name: 'AX 인재전쟁 상위 10% 인재 선정', context: '조코딩AX파트너스', year: '2026' },
  { name: '정보처리산업기사 취득', context: '한국산업인력공단', year: '2025' },
  { name: '탑프로그래머스 2등', context: '프로그래머스', year: '2021' },
];
---

<BaseLayout title="About" description="백엔드 개발자 김삼현의 소개와 경력">
  <PageBanner slot="banner" title={SITE_AUTHOR} eyebrow="Backend / AI Agent Developer">
    <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink-muted" style="word-break: keep-all">
      13년 동안 Java와 Kotlin을 중심으로 Spring 백엔드 시스템을 설계하고 운영해왔습니다.
      서비스 초기 구축부터 아키텍처 설계와 운영까지 여러 단계를 경험했습니다.
      최근에는 LG전자 HVAC AI 챗봇의 백엔드와 멀티 에이전트 구조를 설계하고 실제 서비스에 적용했습니다.
    </p>
  </PageBanner>

  <!-- Experience Timeline -->
  <section class="mb-16">
    <h2 class="mb-8 font-display text-2xl text-ink">Experience</h2>
    <ol class="relative ml-2 border-l-2 border-dashed border-rule">
      {experiences.map((exp, i) => (
        <li class="relative pb-10 pl-8 last:pb-0">
          <span
            class="absolute top-1 -left-[11px] h-5 w-5 rounded-full border-2 border-edge"
            style={`background:${['var(--butter)', 'var(--mint)', 'var(--lilac)', 'var(--peach)'][i % 4]}`}
          />
          <p class="text-sm font-semibold text-ink-faint">{exp.period}</p>
          <h3 class="mt-1.5 font-display text-xl leading-snug text-ink">{exp.company}</h3>
          <p class="mt-1 text-sm font-semibold text-plum">{exp.role}</p>
          <p class="mt-3 leading-relaxed text-ink-muted">{exp.description}</p>
          <ul class="mt-4 flex flex-wrap gap-1.5">
            {exp.techs.map((tech) => (
              <li class="rounded-full bg-paper-2 px-2.5 py-0.5 text-xs font-semibold text-ink-muted">{tech}</li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </section>

  <!-- Skills -->
  <section class="mb-16">
    <h2 class="mb-8 font-display text-2xl text-ink">Skills</h2>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      {skills.map((group) => (
        <div class="sticker-card overflow-hidden">
          <div class="flex items-center gap-2.5 border-b-2 border-edge px-5 py-2.5" style={`background:${group.color}`}>
            <span class="font-mono text-xs font-bold text-on-pastel">{group.icon}</span>
            <h3 class="font-display text-sm text-on-pastel">{group.category}</h3>
          </div>
          <ul class="flex flex-wrap gap-1.5 px-5 py-4">
            {group.items.map((skill) => (
              <li class="rounded-full bg-paper-2 px-2.5 py-0.5 text-xs font-semibold text-ink-muted">{skill}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- Certifications -->
  <section class="mb-16">
    <h2 class="mb-8 font-display text-2xl text-ink">Certifications & Awards</h2>
    <div class="grid gap-5 md:grid-cols-3">
      {certifications.map((cert) => (
        <div class="sticker-card px-5 py-5">
          <div class="flex items-center justify-between gap-3 text-xs font-semibold text-ink-faint">
            <span>{cert.context}</span>
            <span class="rounded-full bg-butter px-2 py-0.5 text-on-pastel">{cert.year}</span>
          </div>
          <p class="mt-4 font-bold leading-snug text-ink">{cert.name}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Education & Programs -->
  <section class="mb-16">
    <h2 class="mb-8 font-display text-2xl text-ink">Education & Programs</h2>
    <div class="grid gap-5 md:grid-cols-2">
      <div class="sticker-card px-5 py-5">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <span class="text-xs font-semibold text-ink-faint">2026 — 현재</span>
          <span class="rounded-full border-2 border-edge bg-mint px-2 py-0.5 text-[11px] font-bold text-on-pastel">진행 중</span>
        </div>
        <p class="mt-4 font-bold text-ink">이어드림스쿨 6기 심화과정</p>
        <p class="mt-1 text-sm text-ink-muted">스타트업 AI 기술인력양성</p>
      </div>
      <div class="sticker-card px-5 py-5">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <span class="text-xs font-semibold text-ink-faint">2024.06 — 현재</span>
          <span class="rounded-full border-2 border-edge bg-mint px-2 py-0.5 text-[11px] font-bold text-on-pastel">진행 중</span>
        </div>
        <p class="mt-4 font-bold text-ink">학점은행제 · 컴퓨터공학 학사</p>
        <p class="mt-1 text-sm text-ink-muted">컴퓨터공학 전공</p>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section>
    <h2 class="mb-6 font-display text-2xl text-ink">Contact</h2>
    <div class="flex flex-wrap gap-3">
      <a href={SOCIAL_LINKS.github} target="_blank" rel="noopener noreferrer" class="sticker-btn bg-butter">
        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" /></svg>
        GitHub
      </a>
      <a href={SOCIAL_LINKS.email} class="sticker-btn bg-paper">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>
        Email
      </a>
    </div>
  </section>
</BaseLayout>
