---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_AUTHOR, SOCIAL_LINKS } from '../consts';

const experiences = [
  {
    period: '2025.09 — 2026.03',
    company: 'LG Energy Solution (프리랜서)',
    role: '백엔드 TechLead / AI Agent 개발자',
    description: 'LGES HVAC AI 챗봇 플랫폼 전체 아키텍처 설계 및 개발 주도. Google ADK 기반 멀티 에이전트 시스템, Spring WebFlux 리액티브 API, 실시간 STT, Terraform IaC 멀티 클라우드 인프라 구축.',
    techs: ['Java 21', 'Kotlin', 'Python', 'Spring Boot 3.5', 'Google ADK', 'LangChain4j', 'FastAPI', 'React', 'MySQL', 'Milvus', 'AWS', 'GCP', 'Terraform'],
  },
  {
    period: '2021.05 — 2024.11',
    company: '(주)일루미나리안',
    role: '백엔드 TechLead',
    description: 'MusicSharesJP 및 GoodVibeWorks 프로젝트의 아키텍처 설계 및 핵심 API 개발. 공용 API 문서 서버, Kotlin Test DSL, Spring Cloud Config 설정 중앙화 등 개발 환경 전반 개선.',
    techs: ['Kotlin', 'Java', 'Spring Boot', 'Spring Cloud', 'JPA', 'Querydsl', 'MySQL', 'AWS', 'Docker', 'Jenkins'],
  },
  {
    period: '2020.12 — 2021.04',
    company: 'LOTTE GFR (프리랜서)',
    role: '풀스택 개발자',
    description: 'NICE CLAUP e커머스 플랫폼 회원/상품 관리 백엔드 API 및 프론트엔드 개발. Facebook Graph API 활용 인스타그램 브랜드 피드 연계.',
    techs: ['Java', 'TypeScript', 'Spring Boot', 'Vue.js', 'JPA', 'MySQL', 'Redis'],
  },
  {
    period: '2015.09 — 2020.05',
    company: '(주)애니포인트미디어',
    role: '풀스택 개발자',
    description: 'TV 광고 플랫폼 1.0/2.0 설계·구축, SKB 통합 광고 시스템 아키텍처 설계. Axon Framework CQRS 패턴 도입, AWS 인프라 구축 및 운영.',
    techs: ['Kotlin', 'Java', 'TypeScript', 'Spring Boot', 'Spring Cloud', 'Vue.js', 'AngularJS', 'Axon Framework', 'MySQL', 'Redis', 'AWS'],
  },
  {
    period: '2013.02 — 2015.06',
    company: '(주)뚝딱',
    role: '풀스택 / 백엔드 개발자',
    description: '한국 전력 연구원 수요 예측 시스템 R 기반 통계 모델 설계 및 서비스 API 개발. 특허청 특허출원 프로그램, 자체 해운 솔루션 개발.',
    techs: ['Java', 'JavaScript', 'R', 'Spring Framework', 'jQuery', 'MyBatis', 'Oracle'],
  },
];

const skills = [
  {
    category: 'Backend',
    icon: '{ }',
    items: ['Java (13년)', 'Kotlin (4년)', 'Spring Boot', 'Spring Cloud', 'Spring WebFlux', 'JPA', 'Querydsl'],
    color: 'bg-blue-100 text-blue-700 dark:bg-blue-900/20 dark:text-blue-400',
  },
  {
    category: 'AI / ML',
    icon: 'AI',
    items: ['Google ADK', 'LangChain4j', 'LangChain', 'OpenAI API', 'Milvus', 'RAG', 'Agent Architecture'],
    color: 'bg-violet-100 text-violet-700 dark:bg-violet-900/20 dark:text-violet-400',
  },
  {
    category: 'Cloud & Infra',
    icon: 'C',
    items: ['AWS (ECS, CloudFront, RDS, S3)', 'GCP (GKE)', 'Docker', 'Terraform'],
    color: 'bg-amber-100 text-amber-700 dark:bg-amber-900/20 dark:text-amber-400',
  },
  {
    category: 'Frontend',
    icon: 'F',
    items: ['JavaScript (8년)', 'TypeScript (2년)', 'Vue.js', 'React', 'Nuxt.js'],
    color: 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/20 dark:text-emerald-400',
  },
  {
    category: 'Database',
    icon: 'DB',
    items: ['MySQL', 'PostgreSQL', 'Redis', 'Oracle', 'Milvus (Vector DB)'],
    color: 'bg-cyan-100 text-cyan-700 dark:bg-cyan-900/20 dark:text-cyan-400',
  },
  {
    category: 'DevOps',
    icon: 'D',
    items: ['Jenkins', 'GitHub Actions', 'Docker', 'Terraform', 'Git'],
    color: 'bg-rose-100 text-rose-700 dark:bg-rose-900/20 dark:text-rose-400',
  },
];

const certifications = [
  { name: '정보처리산업기사', org: '한국산업인력공단', year: '2025' },
  { name: '탑프로그래머스 선정 (2등)', org: '프로그래머스', year: '2021' },
];
---

<BaseLayout title="About" description="13년차 백엔드 개발자 김삼현의 소개 및 경력 사항">
  <div class="py-4">
    <!-- Hero -->
    <div class="mb-12">
      <div class="mb-4 flex h-20 w-20 items-center justify-center rounded-2xl bg-gradient-to-br from-primary-500 to-accent-500 text-3xl font-bold text-white shadow-lg shadow-primary-500/20">
        S
      </div>
      <h1 class="mb-2 text-3xl font-extrabold">{SITE_AUTHOR}</h1>
      <p class="text-lg font-medium text-primary-600 dark:text-primary-400">Backend / Full-Stack Developer</p>
      <p class="mt-4 max-w-lg leading-relaxed text-text-muted dark:text-text-muted-dark">
        Java와 Kotlin을 중심으로 13년간 Spring 기반 백엔드 시스템을 설계하고 운영해왔습니다.
        서비스 초기 구축부터 아키텍처 설계와 팀 리딩까지 다양한 단계를 경험했고,
        최근에는 LG에너지솔루션 글로벌 챗봇 프로젝트에서 AI Agent 시스템을 직접 설계하고 개발하며
        LLM과 RAG 기술을 프로덕션에 적용했습니다.
      </p>
    </div>

    <!-- Skills -->
    <section class="mb-14">
      <h2 class="mb-6 text-xl font-bold">Skills</h2>
      <div class="stagger-children grid grid-cols-1 gap-4 sm:grid-cols-2">
        {skills.map((group) => (
          <div class="rounded-xl border border-border p-5 dark:border-border-dark">
            <div class="mb-3 flex items-center gap-2.5">
              <span class:list={['flex h-8 w-8 items-center justify-center rounded-lg text-xs font-bold', group.color]}>
                {group.icon}
              </span>
              <h3 class="font-semibold">{group.category}</h3>
            </div>
            <div class="flex flex-wrap gap-1.5">
              {group.items.map((skill) => (
                <span class="rounded-md bg-gray-50 px-2 py-0.5 text-xs font-medium text-text-muted dark:bg-gray-800/50 dark:text-text-muted-dark">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Experience Timeline -->
    <section class="mb-14">
      <h2 class="mb-6 text-xl font-bold">Experience</h2>
      <div class="space-y-6">
        {experiences.map((exp) => (
          <div class="relative rounded-xl border border-border p-5 pl-6 dark:border-border-dark">
            <div class="absolute left-0 top-6 h-8 w-1 rounded-r-full bg-gradient-to-b from-primary-500 to-accent-500" />
            <p class="text-xs font-semibold uppercase tracking-wider text-text-muted dark:text-text-muted-dark">{exp.period}</p>
            <h3 class="mt-1 text-lg font-bold">{exp.company}</h3>
            <p class="text-sm font-medium text-primary-600 dark:text-primary-400">{exp.role}</p>
            <p class="mt-2 text-sm leading-relaxed text-text-muted dark:text-text-muted-dark">{exp.description}</p>
            <div class="mt-3 flex flex-wrap gap-1.5">
              {exp.techs.map((tech) => (
                <span class="rounded-md bg-gray-50 px-2 py-0.5 text-xs font-medium text-text-muted dark:bg-gray-800/50 dark:text-text-muted-dark">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Certifications -->
    <section class="mb-14">
      <h2 class="mb-6 text-xl font-bold">Certifications & Awards</h2>
      <div class="space-y-3">
        {certifications.map((cert) => (
          <div class="flex items-center justify-between rounded-xl border border-border p-4 dark:border-border-dark">
            <div>
              <p class="font-semibold">{cert.name}</p>
              <p class="text-sm text-text-muted dark:text-text-muted-dark">{cert.org}</p>
            </div>
            <span class="text-sm font-medium text-text-muted dark:text-text-muted-dark">{cert.year}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Education -->
    <section class="mb-14">
      <h2 class="mb-6 text-xl font-bold">Education</h2>
      <div class="rounded-xl border border-border p-4 dark:border-border-dark">
        <p class="font-semibold">학점은행제 — 컴퓨터 공학 (학사)</p>
        <p class="text-sm text-text-muted dark:text-text-muted-dark">2024.06 ~ 현재 (진행 중)</p>
      </div>
    </section>

    <!-- Contact -->
    <section>
      <h2 class="mb-4 text-xl font-bold">Contact</h2>
      <div class="flex gap-3">
        <a
          href={SOCIAL_LINKS.github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-xl border border-border px-4 py-2.5 text-sm font-medium transition-all hover:bg-gray-50 hover:-translate-y-0.5 dark:border-border-dark dark:hover:bg-gray-800"
        >
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" /></svg>
          GitHub
        </a>
        <a
          href={SOCIAL_LINKS.email}
          class="inline-flex items-center gap-2 rounded-xl border border-border px-4 py-2.5 text-sm font-medium transition-all hover:bg-gray-50 hover:-translate-y-0.5 dark:border-border-dark dark:hover:bg-gray-800"
        >
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>
          Email
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
